---
import Icon from "./Icon.astro";

---

<footer class="bg-cream text-ink py-12 border-t border-rose-light">
  <div class="max-w-7xl mx-auto px-4 text-center">
    <h3 class="text-2xl font-lobster mb-6">Let's Connect</h3>
    <ul class="flex justify-center gap-8 mb-8">
      <li>
        <a
          href="https://www.linkedin.com/in/andreina-di-brigida"
          aria-label="linkedin"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-icon-btn"
        >
          <span class="footer-icon-svgContainer">
            <Icon name="fa6-brands:linkedin" />
          </span>
          <span class="footer-icon-bg"></span>
        </a>
      </li>
      <li>
        <a
          href="https://github.com/Akiarakira"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="footer-icon-btn"
        >
          <span class="footer-icon-svgContainer">
            <Icon name="fa6-brands:github" />
          </span>
          <span class="footer-icon-bg"></span>
        </a>
      </li>
      <li>
        <a
          href="https://www.instagram.com/andree_gabby/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="footer-icon-btn"
        >
          <span class="footer-icon-svgContainer">
            <Icon name="fa6-brands:instagram" />
          </span>
          <span class="footer-icon-bg"></span>
        </a>
      </li>
      <li>
        <a
          href="mailto:Andreinadibrigida8@gmail.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Email"
          class="footer-icon-btn"
        >
          <span class="footer-icon-svgContainer">
            <Icon name="fa6-regular:envelope" />
          </span>
          <span class="footer-icon-bg"></span>
        </a>
      </li>
    </ul>
    <p class="text-muted text-sm">
      © 2025 Andreina Di Brigida. All rights reserved.
    </p>
  </div>
</footer>
