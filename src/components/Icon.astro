---
import Alpine from "~icons/simple-icons/alpinedotjs";
import ArrowDown from "~icons/fa6-solid/arrow-down";
import ArrowLeft from "~icons/fa6-solid/arrow-left";
import ArrowRight from "~icons/fa6-solid/arrow-right";
import Bars from "~icons/fa6-solid/bars";
import CommentDots from "~icons/fa6-solid/comment-dots";
import Css3 from "~icons/simple-icons/css3";
import Download from "~icons/fa6-solid/download";
import Envelope from "~icons/fa6-regular/envelope";
import Figma from "~icons/simple-icons/figma";
import Github from "~icons/fa6-brands/github";
import Heart from "~icons/fa6-solid/heart";
import Htmx from "~icons/simple-icons/htmx";
import Hubspot from "~icons/simple-icons/hubspot";
import Html5 from "~icons/simple-icons/html5";
import Instagram from "~icons/fa6-brands/instagram";
import Javascript from "~icons/simple-icons/javascript";
import Linkedin from "~icons/fa6-brands/linkedin";
import LinkedinIn from "~icons/fa6-brands/linkedin-in";
import MongoDb from "~icons/simple-icons/mongodb";
import Moon from "~icons/fa6-solid/moon";
import MugHot from "~icons/fa6-solid/mug-hot";
import Mysql from "~icons/simple-icons/mysql";
import NodeJs from "~icons/simple-icons/nodedotjs";
import Php from "~icons/simple-icons/php";
import Python from "~icons/simple-icons/python";
import React from "~icons/simple-icons/react";
import Sass from "~icons/simple-icons/sass";
import Shopify from "~icons/simple-icons/shopify";
import Star from "~icons/fa6-solid/star";
import Sun from "~icons/fa6-solid/sun";
import Tailwind from "~icons/simple-icons/tailwindcss";
import Typescript from "~icons/simple-icons/typescript";
import Whatsapp from "~icons/fa6-brands/whatsapp";
import WordPress from "~icons/simple-icons/wordpress";
import Xmark from "~icons/fa6-solid/xmark";

const icons = {
  "fa6-brands:github": Github,
  "fa6-brands:instagram": Instagram,
  "fa6-brands:linkedin": Linkedin,
  "fa6-brands:linkedin-in": LinkedinIn,
  "fa6-brands:whatsapp": Whatsapp,
  "fa6-regular:envelope": Envelope,
  "fa6-solid:arrow-down": ArrowDown,
  "fa6-solid:arrow-left": ArrowLeft,
  "fa6-solid:arrow-right": ArrowRight,
  "fa6-solid:bars": Bars,
  "fa6-solid:comment-dots": CommentDots,
  "fa6-solid:download": Download,
  "fa6-solid:heart": Heart,
  "fa6-solid:moon": Moon,
  "fa6-solid:mug-hot": MugHot,
  "fa6-solid:star": Star,
  "fa6-solid:sun": Sun,
  "fa6-solid:xmark": Xmark,
  "simple-icons:alpinedotjs": Alpine,
  "simple-icons:css3": Css3,
  "simple-icons:figma": Figma,
  "simple-icons:htmx": Htmx,
  "simple-icons:hubspot": Hubspot,
  "simple-icons:html5": Html5,
  "simple-icons:javascript": Javascript,
  "simple-icons:mongodb": MongoDb,
  "simple-icons:mysql": Mysql,
  "simple-icons:nodedotjs": NodeJs,
  "simple-icons:php": Php,
  "simple-icons:python": Python,
  "simple-icons:react": React,
  "simple-icons:sass": Sass,
  "simple-icons:shopify": Shopify,
  "simple-icons:tailwindcss": Tailwind,
  "simple-icons:typescript": Typescript,
  "simple-icons:wordpress": WordPress,
};

interface Props {
  name: keyof typeof icons;
  class?: string;
  ariaLabel?: string;
}

const { name, class: className, ariaLabel } = Astro.props;
const IconComponent = icons[name];
---

<IconComponent
  class={className}
  role={ariaLabel ? "img" : undefined}
  aria-label={ariaLabel}
  aria-hidden={ariaLabel ? undefined : "true"}
/>
