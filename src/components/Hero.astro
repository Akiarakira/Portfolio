---
import { Image } from "astro:assets";
import heroImage from "../assets/me/Akiara-hero.png";
import SeeMyWorkButton from "./SeeMyWorkButton.astro";

const baseUrl = import.meta.env.BASE_URL;
---

<section class="title-section relative pt-12 pb-20 overflow-hidden">
  <section
    class="title-container-hero grid md:grid-cols-2 gap-12 items-center relative z-10"
  >
    <div class="pl-1">
      <h1
        class="title text-5xl md:text-6xl font-lobster text-rose-dark mb-4"
        id="main_title"
      >
        <span id="typewriter-text">Full-Stack Developer</span>
        <span class="typewriter-cursor"></span>
      </h1>
      <h2
        class="name title text-4xl md:text-5xl font-lobster text-rose-accent mb-6"
      >
        Andreina Di Brigida
      </h2>
      <p class="description text-lg text-gray-700 mb-8 leading-relaxed">
        Front-End Engineer and Shopify Specialist with 4 years of experience,
        focused on Shopify 2.0, Liquid, Cart API, GraphQL integrations, and
        conversion-focused, mobile-first storefronts across Shopify, WordPress,
        and custom Node.js ecosystems.
      </p>
      <div class="flex gap-4">
        <a
          href={`${baseUrl}documents/Shopify Developer Andreina Di Brigida.pdf`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary inline-block"
        >
          <i class="fa-solid fa-download mr-2"></i>Download CV
        </a>
        <SeeMyWorkButton href="#projects" />
      </div>
    </div>
    <div class="hero-image-wrapper">
      <Image
        src={heroImage}
        alt="Andreina Di Brigida"
        class="hero-image"
        loading="eager"
        decoding="async"
      />
    </div>
  </section>
</section>

<style>
  #main_title {
    min-height: 1.2em;
  }

  .hero-image-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .hero-image {
    width: 100%;
    max-width: 23rem;
    height: auto;
    object-fit: contain;
    -webkit-mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 1) 78%,
      rgba(0, 0, 0, 0) 100%
    );
    mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 1) 78%,
      rgba(0, 0, 0, 0) 100%
    );
    filter: drop-shadow(0 18px 35px rgba(15, 23, 42, 0.18));
    animation: hero-float 6s ease-in-out infinite;
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @media (max-width: 767px) {
    .hero-image-wrapper {
      margin-top: 2rem;
    }
    .hero-image {
      max-width: 15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image {
      animation: none;
    }
  }
</style>

<script>
  if (typeof window !== "undefined") {
    const roleSets = {
      en: ["Full-Stack Developer", "Shopify Specialist", "WordPress Expert"],
      es: [
        "Desarrolladora Full-Stack",
        "Especialista en Shopify",
        "Experta en WordPress",
      ],
    };
    let roles = roleSets[document.documentElement.dataset.language || "en"];

    const textEl = document.getElementById("typewriter-text");

    if (textEl) {
      let roleIndex = 0;
      let charIndex = 0;
      let isDeleting = false;

      window.addEventListener("languagechange", (event) => {
        roles = roleSets[event.detail.language] || roleSets.en;
        roleIndex = 0;
        charIndex = 0;
        isDeleting = false;
      });

      const typingSpeed = 100;
      const deletingSpeed = 60;
      const pauseBetweenRoles = 1500;

      const type = () => {
        const current = roles[roleIndex];

        if (!isDeleting) {
          charIndex++;
          textEl.textContent = current.slice(0, charIndex);

          if (charIndex === current.length) {
            isDeleting = true;
            setTimeout(type, pauseBetweenRoles);
            return;
          }
        } else {
          charIndex--;
          textEl.textContent = current.slice(0, charIndex);

          if (charIndex === 0) {
            isDeleting = false;
            roleIndex = (roleIndex + 1) % roles.length;
          }
        }

        const delay = isDeleting ? deletingSpeed : typingSpeed;
        setTimeout(type, delay);
      };

      type();
    }
  }
</script>
