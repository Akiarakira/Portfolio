---
interface Props {
  href: string;
  label?: string;
}

const { href, label = "See My Work" } = Astro.props;
---

<a href={href} class="btn-secondary btn-secondary-stars inline-block">
  <span class="btn-secondary-stars__label">
    <i class="fa-solid fa-arrow-down"></i>
    <span>{label}</span>
  </span>
  {
    [1, 2, 3, 4, 5, 6].map((star) => (
      <span class={`star-${star}`} aria-hidden="true">
        <svg viewBox="0 0 784.11 815.53" xmlns="http://www.w3.org/2000/svg">
          <path
            class="star-fill"
            d="M392.05 0c-20.9,210.08 -184.06,378.41 -392.05,407.78 207.96,29.37 371.12,197.68 392.05,407.74 20.93,-210.06 184.09,-378.37 392.05,-407.74 -207.98,-29.38 -371.16,-197.69 -392.06,-407.78z"
          ></path>
        </svg>
      </span>
    ))
  }
</a>
