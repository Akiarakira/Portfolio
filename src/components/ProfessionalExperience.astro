<section id="experience" class="experience-section py-20">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="section-title text-center mb-12">Professional Experience</h2>
    <div class="relative">
      <div class="pointer-events-none timeline-line-mobile md:hidden"></div>
      <div>
        {
          experiences.map((experience) => (
            <article class="timeline-item z-10 md:flex md:items-center py-8">
              <div class="absolute left-6 top-12 -translate-x-1/2 -translate-y-1/2 md:left-1/2 md:top-1/2 md:-translate-x-1/2 md:-translate-y-1/2">
                <div class="timeline-dot shadow-elegant" />
              </div>
              <div
                class:list={[
                  "w-full",
                  "pl-12",
                  "md:w-1/2",
                  experience.side === "left"
                    ? "md:pl-0 md:pr-10 md:text-right"
                    : "md:ml-auto md:pl-10",
                ]}
              >
                <div class="mb-3">
                  <h3 class="subtitle-elegant mb-1">
                    {experience.title} – {experience.company}
                  </h3>
                  <p class="text-xs font-semibold uppercase tracking-wide text-rose-accent leading-relaxed break-words">
                    {experience.period}
                  </p>
                </div>
                <ul class="mt-1 space-y-1 text-gray-600 text-sm leading-relaxed">
                  {experience.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
                <p class="mt-2 text-xs text-gray-600">
                  <span class="font-semibold">Stack:</span> {experience.stack}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
